generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  BUYER
  INDIVIDUAL_SELLER
  AUCTIONEER
  ADMIN
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum ListingType {
  AUCTION
  FIXED_PRICE
}

enum ListingStatus {
  ACTIVE
  ENDED
  SOLD
  AWAITING_PAYMENT
  PAID
}

enum UserStatus {
  ACTIVE
  BANNED_FRAUD
  SUSPENDED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

// ===== LIVE AUCTION ROOM ENUMS =====

enum LiveRoomStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum LiveRoomItemStatus {
  PENDING
  ACTIVE
  SOLD
  PASSED
}

// ============================================================
// MODELS
// ============================================================

model User {
  id                    String          @id @default(cuid())
  name                  String
  displayName           String?
  email                 String          @unique
  password              String
  idNumber              String          @unique
  phone                 String?
  deviceId              String?
  ip                    String?
  avatar                String?
  bio                   String?

  // KYC PHOTOS
  idPhotoUrl            String?
  selfieUrl             String?

  role                  Role            @default(BUYER)
  isAuctioneerApproved  Boolean         @default(false)
  kycStatus             KycStatus       @default(NONE)
  canSell               Boolean         @default(false)
  kycLevel              Int             @default(1)
  kycData               Json?
  status                UserStatus      @default(ACTIVE)
  sellerRequirements    Json?
  sellerProfile         Json?
  favorites             Json?

  // Relations (existing)
  listings              Listing[]       @relation("UserListings")
  bids                  Bid[]           @relation("UserBids")
  currentBids           Listing[]       @relation("CurrentBidder")
  wonListings           Listing[]       @relation("WinnerAuctions")
  ratingsGiven          Rating[]        @relation("UserRatings")
  ratingsReceived       Rating[]        @relation("SellerRatings")
  ghostLeadsAsBuyer     GhostLead[]     @relation("GhostLeadUser")
  ghostLeadsAsSeller    GhostLead[]     @relation("GhostLeadSeller")
  reportsGiven          Report[]        @relation("Reporter")
  soldItems             SoldItem[]      @relation("SellerSoldItems")

  // Private Sourcing
  sourcingInstructions  SourcingInstruction[] @relation("UserSourcingInstructions")

  // Live Auction Room (NEW)
  liveRoomsAsAuctioneer LiveRoom[]      @relation("UserLiveRooms")
  liveBids              LiveBid[]       @relation("UserLiveBids")
  liveMessages          LiveMessage[]   @relation("UserLiveMessages")

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("users")
}

model Listing {
  id                    String          @id @default(cuid())
  sellerId              String
  sellerRole            String          @default("SELLER")
  title                 String
  description           String?
  category              String          @default("Other")
  condition             String          @default("USED")

  // ===== IMAGE UPLOAD SYSTEM =====
  mainImageUrl          String?
  imageUrls             String[]
  odometerVideoUrl      String?
  images                Json?

  listingType           ListingType     @default(FIXED_PRICE)

  // Auction fields
  startingPrice         Float?
  reservePrice          Float?
  currentBid            Float?
  currentBidderId       String?
  endTime               DateTime?
  duration              String?
  proxyBids             Json?
  maxBids               Json?
  isLast10Min           Boolean         @default(false)
  increment             Int             @default(1000)

  // Fixed Price fields
  price                 Float?
  stock                 Int             @default(1)
  isNegotiable          Boolean         @default(false)

  // Status & Tracking
  status                ListingStatus   @default(ACTIVE)
  views                 Int             @default(0)
  winnerId              String?
  finalPrice            Float?
  paymentDeadline       DateTime?
  requiredKycLevel      Int             @default(1)

  // Vehicle Specifications
  year                  Int?
  kilometers            Int?
  color                 String?
  engineSize            String?
  transmission          String?
  fuelType              String?

  // ===== VERIFICATION FIELDS =====
  vinNumber             String?         @unique
  engineNumber          String?         @unique
  idDocumentUrl         String?
  licenseDiskUrl        String?
  isVerified            Boolean         @default(false)
  verificationStatus    String          @default("PENDING")

  // ===== PRIVATE SOURCING =====
  isPrivate             Boolean         @default(false)
  sourceBadge           String?
  privateStatus         String?         @default("Available Privately")
  trustLine             String?

  // Timestamps
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  seller                User            @relation("UserListings", fields: [sellerId], references: [id], onDelete: Cascade)
  currentBidder         User?           @relation("CurrentBidder", fields: [currentBidderId], references: [id])
  winner                User?           @relation("WinnerAuctions", fields: [winnerId], references: [id])
  bids                  Bid[]           @relation("ListingBids")
  ratings               Rating[]        @relation("ListingRatings")
  ghostLeads            GhostLead[]
  reports               Report[]        @relation("ReportedListing")

  // Live Auction Room (NEW)
  liveRoomItems         LiveRoomItem[]

  // Indexes
  @@index([sellerId])
  @@index([category])
  @@index([listingType])
  @@index([status])
  @@index([createdAt])
  @@index([vinNumber])
  @@index([engineNumber])
  @@index([isPrivate])
  @@map("listings")
}

model Bid {
  id                    String          @id @default(cuid())
  listingId             String
  bidderId              String
  amount                Float
  createdAt             DateTime        @default(now())

  listing               Listing         @relation("ListingBids", fields: [listingId], references: [id], onDelete: Cascade)
  bidder                User            @relation("UserBids", fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([bidderId])
  @@map("bids")
}

model Rating {
  id                    String          @id @default(cuid())
  buyerId               String
  sellerId              String
  listingId             String
  stars                 Int             @default(5)
  comment               String?
  tags                  String[]
  createdAt             DateTime        @default(now())

  buyer                 User            @relation("UserRatings", fields: [buyerId], references: [id], onDelete: Cascade)
  seller                User            @relation("SellerRatings", fields: [sellerId], references: [id], onDelete: Cascade)
  listing               Listing         @relation("ListingRatings", fields: [listingId], references: [id], onDelete: Cascade)

  @@map("ratings")
}

model Report {
  id                    String          @id @default(cuid())
  buyerId               String
  sellerId              String
  listingId             String
  buyerName             String
  sellerName            String
  listingTitle          String
  amount                Float?
  evidence              String?
  status                ReportStatus    @default(PENDING)
  createdAt             DateTime        @default(now())

  reporter              User            @relation("Reporter", fields: [buyerId], references: [id], onDelete: Cascade)
  listing               Listing         @relation("ReportedListing", fields: [listingId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model GhostLead {
  id                    String          @id @default(cuid())
  listingId             String
  sellerId              String
  userId                String
  name                  String
  phone                 String?
  email                 String?
  maxBid                Float
  bidCount              Int
  category              String
  title                 String
  finalPrice            Float
  capturedAt            DateTime        @default(now())
  contacted             Boolean         @default(false)
  sentToSeller          Boolean         @default(false)
  sentToBuyer           Boolean         @default(false)

  listing               Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user                  User            @relation("GhostLeadUser", fields: [userId], references: [id], onDelete: Cascade)
  seller                User            @relation("GhostLeadSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("ghost_leads")
}

model SoldItem {
  id                    String          @id @default(cuid())
  listingId             String          @unique
  sellerId              String
  title                 String
  winnerName            String
  finalPrice            Float
  soldAt                DateTime        @default(now())

  seller                User            @relation("SellerSoldItems", fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("sold_items")
}

// ============================================================
// PRIVATE SOURCING
// ============================================================

model SourcingInstruction {
  id                String    @id @default(cuid())

  userId            String?
  user              User?     @relation("UserSourcingInstructions", fields: [userId], references: [id], onDelete: SetNull)

  vehicleWanted     String
  budgetRange       String
  yearKmPref        String?
  urgency           String
  whatsapp          String
  privateEmail      String?

  status            String    @default("NEW")
  notes             String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@map("sourcing_instructions")
}

// ============================================================
// LIVE AUCTION ROOM (NEW)
// ============================================================

model LiveRoom {
  id                  String          @id @default(cuid())
  title               String
  scheduledFor        DateTime?
  status              LiveRoomStatus  @default(SCHEDULED)
  startedAt           DateTime?
  endedAt             DateTime?

  // Who is running the auction
  auctioneerId        String
  auctioneer          User            @relation("UserLiveRooms", fields: [auctioneerId], references: [id])

  // Currently active car in the queue (nullable)
  currentItemId       String?

  // Stats
  viewerCount         Int             @default(0)
  peakViewerCount     Int             @default(0)

  // Relations
  items               LiveRoomItem[]
  messages            LiveMessage[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status])
  @@index([auctioneerId])
  @@index([createdAt])
  @@map("live_rooms")
}

model LiveRoomItem {
  id                  String              @id @default(cuid())

  liveRoomId          String
  liveRoom            LiveRoom            @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)

  listingId           String
  listing             Listing             @relation(fields: [listingId], references: [id])

  // Position in the queue (0 = first up)
  order               Int                 @default(0)

  // Pricing
  startPrice          Float
  currentBid          Float?
  currentBidderId     String?
  currentBidderName   String?
  soldPrice           Float?

  // Status flow: PENDING → ACTIVE → SOLD/PASSED
  status              LiveRoomItemStatus  @default(PENDING)

  // Bidding metrics
  bidCount            Int                 @default(0)
  lastBidAt           DateTime?

  // Countdown (10 sec auto-hammer + 15 sec anti-snipe extension)
  countdownEnds       DateTime?
  extendedCount       Int                 @default(0)

  // Relations
  bids                LiveBid[]

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([liveRoomId])
  @@index([listingId])
  @@index([status])
  @@index([order])
  @@map("live_room_items")
}

model LiveBid {
  id                  String        @id @default(cuid())

  liveRoomItemId      String
  liveRoomItem        LiveRoomItem  @relation(fields: [liveRoomItemId], references: [id], onDelete: Cascade)

  bidderId            String
  bidder              User          @relation("UserLiveBids", fields: [bidderId], references: [id])

  bidderName          String
  amount              Float
  createdAt           DateTime      @default(now())

  @@index([liveRoomItemId])
  @@index([bidderId])
  @@index([createdAt])
  @@map("live_bids")
}

model LiveMessage {
  id                  String        @id @default(cuid())

  liveRoomId          String
  liveRoom            LiveRoom      @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)

  userId              String?
  user                User?         @relation("UserLiveMessages", fields: [userId], references: [id], onDelete: SetNull)

  userName            String
  message             String
  isSystem            Boolean       @default(false)   // system messages: "Thabo bid R45,000", "SOLD!"

  createdAt           DateTime      @default(now())

  @@index([liveRoomId])
  @@index([createdAt])
  @@map("live_messages")
}