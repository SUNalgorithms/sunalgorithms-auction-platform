generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String          @id @default(cuid())
  name                String
  displayName         String?
  email               String          @unique
  password            String
  idNumber            String          @unique
  phone               String?
  deviceId            String?
  ip                  String?
  avatar              String?
  bio                 String?

  // ===== ROLE & KYC SYSTEM =====
  role                String          @default("BUYER") // "BUYER" | "INDIVIDUAL_SELLER" | "AUCTIONEER" | "ADMIN"
  isAuctioneerApproved Boolean        @default(false) // Auctioneers are invite-only
  kycStatus           String          @default("NONE") // "NONE" | "PENDING" | "VERIFIED"
  canSell             Boolean         @default(false)

  // ===== EXISTING FIELDS =====
  kycLevel            Int             @default(1)
  kycData             Json?
  status              String          @default("ACTIVE")
  sellerRequirements  Json?
  sellerProfile       Json?
  favorites           Json?

  // ===== RELATIONS (FIXED to prevent errors) =====
  listings            Listing[]       @relation("UserListings")
  bids                Bid[]           @relation("UserBids")
  currentBids         Listing[]       @relation("CurrentBidder")
  ratingsGiven        Rating[]        @relation("UserRatings")
  ratingsReceived     Rating[]        @relation("SellerRatings")
  ghostLeadsAsBuyer   GhostLead[]     @relation("GhostLeadUser")
  ghostLeadsAsSeller  GhostLead[]     @relation("GhostLeadSeller")
  reportsGiven        Report[]        @relation("Reporter")
  soldItems           SoldItem[]      @relation("SellerSoldItems")

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Listing {
  id                  String          @id @default(cuid())
  sellerId            String
  sellerRole          String          @default("SELLER") // "SELLER" | "AUCTIONEER"
  title               String
  description         String?
  category            String          @default("Other") // "Motorcycles" | "Vehicles" | "TLB/Machinery" | "Electronics" | "Other"
  condition           String          @default("USED") // "NEW" | "USED" | "FOR_PARTS"
  images              Json?

  listingType         String          // "AUCTION" | "FIXED_PRICE"
  
  // ===== AUCTION FIELDS =====
  startingPrice       Float?
  reservePrice        Float?
  currentBid          Float?
  currentBidderId     String?
  endTime             DateTime?
  duration            String?
  proxyBids           Json?          // Adapted from Auction
  maxBids             Json?          // Adapted from Auction
  isLast10Min         Boolean         @default(false)
  increment           Int             @default(1000)

  // ===== FIXED PRICE FIELDS =====
  price               Float?
  stock               Int             @default(1)
  isNegotiable        Boolean         @default(false)

  // ===== COMMON FIELDS =====
  status              String          @default("ACTIVE") // "ACTIVE" | "SOLD" | "ENDED" | "AWAITING_PAYMENT" | "PAID"
  views               Int             @default(0)
  winnerId            String?
  finalPrice          Float?
  paymentDeadline     DateTime?
  requiredKycLevel    Int             @default(1)
  
  // ===== VEHICLE SPECS (AutoTrader Style) =====
  year                Int?
  kilometers          Int?
  color               String?
  engineSize          String?
  transmission        String?
  fuelType            String?

  // ===== VERIFICATION FIELDS (Stolen Vehicle Prevention) =====
  vinNumber           String?
  engineNumber        String?
  idDocumentUrl       String?
  licenseDiskUrl      String?
  odometerVideoUrl    String?
  isVerified          Boolean         @default(false)
  verificationStatus  String          @default("PENDING") // "PENDING" | "VERIFIED" | "REJECTED"

  // ===== RELATIONS (Adapted to Listing) =====
  seller              User            @relation("UserListings", fields: [sellerId], references: [id])
  currentBidder       User?           @relation("CurrentBidder", fields: [currentBidderId], references: [id])
  winner              User?           @relation("WinnerAuctions", fields: [winnerId], references: [id])
  bids                Bid[]           @relation("ListingBids")
  ratings             Rating[]        @relation("ListingRatings")
  ghostLeads          GhostLead[]
  reports             Report[]        @relation("ReportedListing")

  // ===== INDEXES (For speed) =====
  @@index([sellerId])
  @@index([category])
  @@index([listingType])
  @@index([status])
  @@index([createdAt])
  @@map("listings")
}

model Bid {
  id                  String          @id @default(cuid())
  listingId           String
  bidderId            String
  amount              Float
  createdAt           DateTime        @default(now())

  // ===== RELATIONS =====
  listing             Listing         @relation("ListingBids", fields: [listingId], references: [id])
  bidder              User            @relation("UserBids", fields: [bidderId], references: [id])

  @@index([listingId])
  @@index([bidderId])
}

model Rating {
  id                  String          @id @default(cuid())
  buyerId             String
  sellerId            String
  listingId           String
  stars               Int             @default(5)
  comment             String?
  tags                String[]
  createdAt           DateTime        @default(now())

  // ===== RELATIONS (Adapted to Listing) =====
  buyer               User            @relation("UserRatings", fields: [buyerId], references: [id])
  seller              User            @relation("SellerRatings", fields: [sellerId], references: [id])
  listing             Listing         @relation("ListingRatings", fields: [listingId], references: [id])
}

model Report {
  id                  String          @id @default(cuid())
  buyerId             String
  sellerId            String
  listingId           String
  buyerName           String
  sellerName          String
  listingTitle        String
  amount              Float?
  evidence            String?
  status              String          @default("PENDING") // "PENDING" | "RESOLVED" | "DISMISSED"
  createdAt           DateTime        @default(now())

  // ===== RELATIONS (Adapted to Listing) =====
  reporter            User            @relation("Reporter", fields: [sellerId], references: [id])
  listing             Listing         @relation("ReportedListing", fields: [listingId], references: [id])
}

model GhostLead {
  id                  String          @id @default(cuid())
  listingId           String
  sellerId            String
  userId              String
  name                String
  phone               String?
  email               String?
  maxBid              Float
  bidCount            Int
  category            String
  title               String
  finalPrice          Float
  capturedAt          DateTime        @default(now())
  contacted           Boolean         @default(false)
  sentToSeller        Boolean         @default(false)
  sentToBuyer         Boolean         @default(false)

  // ===== RELATIONS (Adapted to Listing) =====
  listing             Listing         @relation(fields: [listingId], references: [id])
  user                User            @relation("GhostLeadUser", fields: [userId], references: [id])
  seller              User            @relation("GhostLeadSeller", fields: [sellerId], references: [id])
}

model SoldItem {
  id                  String          @id @default(cuid())
  listingId           String          @unique
  sellerId            String
  title               String
  winnerName          String
  finalPrice          Float
  soldAt              DateTime        @default(now())

  // ===== RELATIONS (Adapted to Listing) =====
  seller              User            @relation("SellerSoldItems", fields: [sellerId], references: [id])
}