generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS – Prevent string injection and ensure data integrity
// ============================================================

enum Role {
  BUYER
  INDIVIDUAL_SELLER
  AUCTIONEER
  ADMIN
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum ListingType {
  AUCTION
  FIXED_PRICE
}

enum ListingStatus {
  ACTIVE
  ENDED
  SOLD
  AWAITING_PAYMENT
  PAID
}

enum UserStatus {
  ACTIVE
  BANNED_FRAUD
  SUSPENDED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

// ============================================================
// MODELS
// ============================================================

model User {
  id                    String          @id @default(cuid())
  name                  String
  displayName           String?
  email                 String          @unique
  password              String
  idNumber              String          @unique
  phone                 String?
  deviceId              String?
  ip                    String?
  avatar                String?
  bio                   String?

  // KYC PHOTOS (stored in R2)
  idPhotoUrl            String?
  selfieUrl             String?

  role                  Role            @default(BUYER)
  isAuctioneerApproved  Boolean         @default(false)
  kycStatus             KycStatus       @default(NONE)
  canSell               Boolean         @default(false)
  kycLevel              Int             @default(1)
  kycData               Json?
  status                UserStatus      @default(ACTIVE)
  sellerRequirements    Json?
  sellerProfile         Json?
  favorites             Json?

  // Relations
  listings              Listing[]       @relation("UserListings")
  bids                  Bid[]           @relation("UserBids")
  currentBids           Listing[]       @relation("CurrentBidder")
  wonListings           Listing[]       @relation("WinnerAuctions")
  ratingsGiven          Rating[]        @relation("UserRatings")
  ratingsReceived       Rating[]        @relation("SellerRatings")
  ghostLeadsAsBuyer     GhostLead[]     @relation("GhostLeadUser")
  ghostLeadsAsSeller    GhostLead[]     @relation("GhostLeadSeller")
  reportsGiven          Report[]        @relation("Reporter")
  soldItems             SoldItem[]      @relation("SellerSoldItems")

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("users")
}

model Listing {
  id                    String          @id @default(cuid())
  sellerId              String
  sellerRole            String          @default("SELLER")
  title                 String
  description           String?
  category              String          @default("Other")
  condition             String          @default("USED")

  // ===== IMAGE UPLOAD SYSTEM =====
  mainImageUrl          String?         // Primary product image (required)
  imageUrls             String[]        // Up to 5 compartment images
  odometerVideoUrl      String?         // 10-second video proof
  images                Json?           // Legacy compatibility (kept for old listings)

  listingType           ListingType     @default(FIXED_PRICE)

  // Auction fields
  startingPrice         Float?
  reservePrice          Float?
  currentBid            Float?
  currentBidderId       String?
  endTime               DateTime?
  duration              String?
  proxyBids             Json?
  maxBids               Json?
  isLast10Min           Boolean         @default(false)
  increment             Int             @default(1000)

  // Fixed Price fields
  price                 Float?
  stock                 Int             @default(1)
  isNegotiable          Boolean         @default(false)

  // Status & Tracking
  status                ListingStatus   @default(ACTIVE)
  views                 Int             @default(0)
  winnerId              String?
  finalPrice            Float?
  paymentDeadline       DateTime?
  requiredKycLevel      Int             @default(1)

  // Vehicle Specifications
  year                  Int?
  kilometers            Int?
  color                 String?
  engineSize            String?
  transmission          String?
  fuelType              String?

  // ===== VERIFICATION FIELDS =====
  vinNumber             String?         @unique   // UNIQUE – prevents stolen car relisting
  engineNumber          String?         @unique   // UNIQUE – prevents odometer fraud
  idDocumentUrl         String?
  licenseDiskUrl        String?
  isVerified            Boolean         @default(false)
  verificationStatus    String          @default("PENDING")

  // Timestamps
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  seller                User            @relation("UserListings", fields: [sellerId], references: [id], onDelete: Cascade)
  currentBidder         User?           @relation("CurrentBidder", fields: [currentBidderId], references: [id])
  winner                User?           @relation("WinnerAuctions", fields: [winnerId], references: [id])
  bids                  Bid[]           @relation("ListingBids")
  ratings               Rating[]        @relation("ListingRatings")
  ghostLeads            GhostLead[]
  reports               Report[]        @relation("ReportedListing")

  // Indexes
  @@index([sellerId])
  @@index([category])
  @@index([listingType])
  @@index([status])
  @@index([createdAt])
  @@index([vinNumber])
  @@index([engineNumber])
  @@map("listings")
}

model Bid {
  id                    String          @id @default(cuid())
  listingId             String
  bidderId              String
  amount                Float
  createdAt             DateTime        @default(now())

  listing               Listing         @relation("ListingBids", fields: [listingId], references: [id], onDelete: Cascade)
  bidder                User            @relation("UserBids", fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([bidderId])
  @@map("bids")
}

model Rating {
  id                    String          @id @default(cuid())
  buyerId               String
  sellerId              String
  listingId             String
  stars                 Int             @default(5)
  comment               String?
  tags                  String[]
  createdAt             DateTime        @default(now())

  buyer                 User            @relation("UserRatings", fields: [buyerId], references: [id], onDelete: Cascade)
  seller                User            @relation("SellerRatings", fields: [sellerId], references: [id], onDelete: Cascade)
  listing               Listing         @relation("ListingRatings", fields: [listingId], references: [id], onDelete: Cascade)

  @@map("ratings")
}

model Report {
  id                    String          @id @default(cuid())
  buyerId               String
  sellerId              String
  listingId             String
  buyerName             String
  sellerName            String
  listingTitle          String
  amount                Float?
  evidence              String?
  status                ReportStatus    @default(PENDING)
  createdAt             DateTime        @default(now())

  reporter              User            @relation("Reporter", fields: [buyerId], references: [id], onDelete: Cascade)
  listing               Listing         @relation("ReportedListing", fields: [listingId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model GhostLead {
  id                    String          @id @default(cuid())
  listingId             String
  sellerId              String
  userId                String
  name                  String
  phone                 String?
  email                 String?
  maxBid                Float
  bidCount              Int
  category              String
  title                 String
  finalPrice            Float
  capturedAt            DateTime        @default(now())
  contacted             Boolean         @default(false)
  sentToSeller          Boolean         @default(false)
  sentToBuyer           Boolean         @default(false)

  listing               Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user                  User            @relation("GhostLeadUser", fields: [userId], references: [id], onDelete: Cascade)
  seller                User            @relation("GhostLeadSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("ghost_leads")
}

model SoldItem {
  id                    String          @id @default(cuid())
  listingId             String          @unique
  sellerId              String
  title                 String
  winnerName            String
  finalPrice            Float
  soldAt                DateTime        @default(now())

  seller                User            @relation("SellerSoldItems", fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("sold_items")
}