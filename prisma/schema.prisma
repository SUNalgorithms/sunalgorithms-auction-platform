generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String          @id @default(cuid())
  name                  String
  displayName           String?
  email                 String          @unique
  password              String
  idNumber              String          @unique
  phone                 String?
  deviceId              String?
  ip                    String?
  avatar                String?
  bio                   String?
  
  // KYC PHOTOS
  idPhotoUrl            String?
  selfieUrl             String?
  
  role                  String          @default("BUYER")
  isAuctioneerApproved  Boolean         @default(false)
  kycStatus             String          @default("NONE")
  canSell               Boolean         @default(false)
  kycLevel              Int             @default(1)
  kycData               Json?
  status                String          @default("ACTIVE")
  sellerRequirements    Json?
  sellerProfile         Json?
  favorites             Json?

  // Relations
  listings              Listing[]       @relation("UserListings")
  bids                  Bid[]           @relation("UserBids")
  currentBids           Listing[]       @relation("CurrentBidder")
  wonListings           Listing[]       @relation("WinnerAuctions")
  ratingsGiven          Rating[]        @relation("UserRatings")
  ratingsReceived       Rating[]        @relation("SellerRatings")
  ghostLeadsAsBuyer     GhostLead[]     @relation("GhostLeadUser")
  ghostLeadsAsSeller    GhostLead[]     @relation("GhostLeadSeller")
  reportsGiven          Report[]        @relation("Reporter")
  soldItems             SoldItem[]      @relation("SellerSoldItems")

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model Listing {
  id                    String          @id @default(cuid())
  sellerId              String
  sellerRole            String          @default("SELLER")
  title                 String
  description           String?
  category              String          @default("Other")
  condition             String          @default("USED")
  
  // ===== IMAGE UPLOAD SYSTEM =====
  // MAIN IMAGE (First/cover photo - required)
  mainImageUrl          String?         // Primary product image
  
  // COMPARTMENT IMAGES (Up to 5 additional photos)
  imageUrls             String[]        // Array of up to 5 image URLs
  
  // ODOMETER VIDEO (10-second proof - required for verification)
  odometerVideoUrl      String?         // Video proof of mileage
  
  // Legacy support (kept for backward compatibility)
  images                Json?           // Original images field
  
  listingType           String          // "AUCTION" or "FIXED_PRICE"

  // Auction fields
  startingPrice         Float?
  reservePrice          Float?
  currentBid            Float?
  currentBidderId       String?
  endTime               DateTime?
  duration              String?
  proxyBids             Json?
  maxBids               Json?
  isLast10Min           Boolean         @default(false)
  increment             Int             @default(1000)

  // Fixed Price fields
  price                 Float?
  stock                 Int             @default(1)
  isNegotiable          Boolean         @default(false)

  // Status & Tracking
  status                String          @default("ACTIVE")
  views                 Int             @default(0)
  winnerId              String?
  finalPrice            Float?
  paymentDeadline       DateTime?
  requiredKycLevel      Int             @default(1)

  // Vehicle Specifications
  year                  Int?
  kilometers            Int?
  color                 String?
  engineSize            String?
  transmission          String?
  fuelType              String?

  // ===== VERIFICATION FIELDS =====
  vinNumber             String?         // VIN for verification
  engineNumber          String?         // Engine number
  idDocumentUrl         String?         // Seller ID document
  licenseDiskUrl        String?         // License disk photo
  isVerified            Boolean         @default(false)
  verificationStatus    String          @default("PENDING")

  // Timestamps
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  seller                User            @relation("UserListings", fields: [sellerId], references: [id], onDelete: Cascade)
  currentBidder         User?           @relation("CurrentBidder", fields: [currentBidderId], references: [id])
  winner                User?           @relation("WinnerAuctions", fields: [winnerId], references: [id])
  bids                  Bid[]           @relation("ListingBids")
  ratings               Rating[]        @relation("ListingRatings")
  ghostLeads            GhostLead[]
  reports               Report[]        @relation("ReportedListing")

  // Indexes
  @@index([sellerId])
  @@index([category])
  @@index([listingType])
  @@index([status])
  @@index([createdAt])
  @@map("listings")
}

model Bid {
  id                    String          @id @default(cuid())
  listingId             String
  bidderId              String
  amount                Float
  createdAt             DateTime        @default(now())

  listing               Listing         @relation("ListingBids", fields: [listingId], references: [id], onDelete: Cascade)
  bidder                User            @relation("UserBids", fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([bidderId])
  @@map("bids")
}

model Rating {
  id                    String          @id @default(cuid())
  buyerId               String
  sellerId              String
  listingId             String
  stars                 Int             @default(5)
  comment               String?
  tags                  String[]
  createdAt             DateTime        @default(now())

  buyer                 User            @relation("UserRatings", fields: [buyerId], references: [id], onDelete: Cascade)
  seller                User            @relation("SellerRatings", fields: [sellerId], references: [id], onDelete: Cascade)
  listing               Listing         @relation("ListingRatings", fields: [listingId], references: [id], onDelete: Cascade)

  @@map("ratings")
}

model Report {
  id                    String          @id @default(cuid())
  buyerId               String
  sellerId              String
  listingId             String
  buyerName             String
  sellerName            String
  listingTitle          String
  amount                Float?
  evidence              String?
  status                String          @default("PENDING")
  createdAt             DateTime        @default(now())

  reporter              User            @relation("Reporter", fields: [buyerId], references: [id], onDelete: Cascade)
  listing               Listing         @relation("ReportedListing", fields: [listingId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model GhostLead {
  id                    String          @id @default(cuid())
  listingId             String
  sellerId              String
  userId                String
  name                  String
  phone                 String?
  email                 String?
  maxBid                Float
  bidCount              Int
  category              String
  title                 String
  finalPrice            Float
  capturedAt            DateTime        @default(now())
  contacted             Boolean         @default(false)
  sentToSeller          Boolean         @default(false)
  sentToBuyer           Boolean         @default(false)

  listing               Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user                  User            @relation("GhostLeadUser", fields: [userId], references: [id], onDelete: Cascade)
  seller                User            @relation("GhostLeadSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("ghost_leads")
}

model SoldItem {
  id                    String          @id @default(cuid())
  listingId             String          @unique
  sellerId              String
  title                 String
  winnerName            String
  finalPrice            Float
  soldAt                DateTime        @default(now())

  seller                User            @relation("SellerSoldItems", fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("sold_items")
}